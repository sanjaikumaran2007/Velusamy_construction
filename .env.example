# Copy this file to .env and fill in real values before deploying.

PORT=3000

# --- Contact form email delivery (nodemailer) ---
# Used by routes/contact.js to relay enquiries to velusamyconstructionpvt@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-app-password
CONTACT_TO_EMAIL=velusamyconstructionpvt@gmail.com
